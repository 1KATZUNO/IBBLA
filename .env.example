# IBBLA - plantilla de entorno. Copiar a .env y completar. NUNCA poner valores reales en este archivo.
# En el servidor: APP_KEY se genera una vez con `php artisan key:generate` (no cambiarla despues: invalida
# sesiones y enlaces firmados). Hostinger no tiene colas ni workers: QUEUE_CONNECTION=sync.
# Despues de cambiar el .env en produccion: php artisan config:cache (la app lee todo por config()).

APP_NAME=IBBLA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ibbla.eu

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# BCCR - Tipo de Cambio API SDDE (Banco Central de Costa Rica)
# Obtener token en: https://sdd.bccr.fi.cr
BCCR_TOKEN=

# WhatsApp (ver config/whatsapp.php). Aqui no va ninguna clave real.
# link = enlaces wa.me, la persona toca "enviar" (por defecto) | meta = Cloud API de Meta, envia solo
# callmebot = gratis, de un tercero y sin garantia: quien activa el bot en su perfil recibe solo; el resto sigue con wa.me
WHATSAPP_DRIVER=link
# Dias de vigencia del enlace firmado al informe de una persona
WHATSAPP_INFORME_DIAS=7
# Roles (slug, separados por coma) que reciben los avisos; necesitan telefono en su usuario
WHATSAPP_AVISOS_ROLES=admin,tesorero
# Cantidad de sobres con la que un culto dispara el aviso (una sola vez por culto)
WHATSAPP_AVISOS_SOBRES=10
# Solo con WHATSAPP_DRIVER=meta
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERSION=v21.0
# Nombre de la plantilla aprobada en Meta (para escribir primero a alguien fuera de la ventana de 24 h)
WHATSAPP_META_PLANTILLA=
# Solo con WHATSAPP_DRIVER=callmebot. Las claves NO van aqui: son de cada persona y se guardan cifradas
# en la base cuando pega su enlace en Mi perfil. Opcionales (se muestran los valores por defecto):
# WHATSAPP_CALLMEBOT_BOT_NUMERO="+34 644 91 07 79"
# WHATSAPP_CALLMEBOT_FRASE="I allow callmebot to send me messages"
# WHATSAPP_CALLMEBOT_CONNECT_TIMEOUT=3
# WHATSAPP_CALLMEBOT_TIMEOUT=10
# Solo para pruebas manuales de quien desarrolla (la aplicacion NO las lee): numero y clave de CallMeBot de la
# persona que prueba, para correr php artisan whatsapp:probar <telefono>. Nunca se commitean valores reales.
# CALLMEBOT_TEST_PHONE=
# CALLMEBOT_TEST_APIKEY=

# Reporte mensual por correo (php artisan reporte:enviar-mensual). Sin destinatarios no envia nada.
# REPORTE_MENSUAL_TO=correo1@ejemplo.org,correo2@ejemplo.org
# REPORTE_MENSUAL_TENANT_ID=7
